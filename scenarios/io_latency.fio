; fio 负载配置：由 check_io_analyzer.py 提供本轮新建 loop 的 filename。
; loop 把普通镜像文件映射为块设备，本配置不写入固定的磁盘路径。
[global]
; 使用 Linux 异步 I/O，直接访问目标设备，避免经过该设备的页缓存。
; loop 的底层镜像仍可能受到宿主缓存影响。
ioengine=libaio
direct=1
; 在 128 MiB 范围内随机写，每次请求 128 KiB。
rw=randwrite
bs=128k
size=128m
; 单个任务最多同时提交 64 个 I/O 请求，形成持续负载。
iodepth=64
numjobs=1
; 按时间运行 4 秒，而不是写满一次测试范围就结束。
time_based=1
runtime=4
; 汇总任务结果，并固定随机序列以减少不同轮次的负载差异。
group_reporting=1
randrepeat=1

[io-latency]
